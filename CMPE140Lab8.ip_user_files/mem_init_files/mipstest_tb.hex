// MIPS Smoke Test - Instruction Memory
// One 32-bit word per line (big-endian), loaded by $readmemh in datapath_if
//
// Word  Addr  Instruction
// ----  ----  -----------
// [0]   0x00  ADDI $1,  $0, 5        => $1  = 5
20010005
// [1]   0x04  ADDI $2,  $0, 3        => $2  = 3
20020003
// [2-3]        NOPs (hazard padding)
00000000
00000000
// [4]   0x10  ADD  $3,  $1, $2       => $3  = 8
00221820
// [5-6]        NOPs
00000000
00000000
// [7]   0x1C  SUB  $4,  $1, $2       => $4  = 2
00222022
// [8-9]        NOPs
00000000
00000000
// [10]  0x28  AND  $5,  $1, $2       => $5  = 1  (5 & 3)
00222824
// [11-12]      NOPs
00000000
00000000
// [13]  0x34  OR   $6,  $1, $2       => $6  = 7  (5 | 3)
00223025
// [14-15]      NOPs
00000000
00000000
// [16]  0x40  SLT  $7,  $2, $1       => $7  = 1  (3 < 5)
0041382A
// [17-18]      NOPs
00000000
00000000
// [19]  0x4C  LUI  $8,  0x0001       => $8  = 0x00010000
3C080001
// [20-21]      NOPs
00000000
00000000
// [22]  0x58  SW   $1,  4($0)        => mem[0x00004] = 5
AC010004
// [23-24]      NOPs
00000000
00000000
// [25]  0x64  LW   $9,  4($0)        => $9  = 5
8C090004
// [26-27]      NOPs
00000000
00000000
// [28]  0x70  SLL  $10, $1,  2       => $10 = 20  (5 << 2)
00015080
// [29-30]      NOPs
00000000
00000000
// [31]  0x7C  BEQ  $3,  $3,  +3     => taken (skips words 34-37)
10630004
// [32-34]      NOPs (2-cycle branch delay)
00000000
00000000
00000000
// [35]  0x88  ADDI $11, $0,  99      => $11 = 99  *** SHOULD BE SKIPPED ***
200B0063
// [36-37]      NOPs (also skipped)
00000000
00000000
// [38]  0x94  ADDI $12, $0,  42      => $12 = 42  (branch landing pad)
200C002A
// [39-40]      NOPs
00000000
00000000
// [41]  0xA0  J    0x29 (self)       => infinite halt loop
08000028
// [42-43]      NOPs
00000000
00000000
00000000
